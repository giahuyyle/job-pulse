PROMETHEUS_VERSION=v3.14.0
GRAFANA_VERSION=13.2.2
TEMPO_VERSION=3.0.3
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Optional daily digest at 9 AM America/New_York. Leave disabled until DNS/secrets are ready.
JOBPULSE_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
JOBPULSE_EMAIL_FROM=
JOBPULSE_APP_URL=http://localhost:5173
JOBPULSE_EMAIL_DAILY_LIMIT=100
JOBPULSE_EMAIL_MONTHLY_LIMIT=3000
JOBPULSE_EMAIL_ALLOWLIST=
